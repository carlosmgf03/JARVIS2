# Copia a .env SOLO para desarrollo local (ignorado por git; solo se carga en compilaciones de desarrollo).
# Preferible: `cargo run -p jarvis-core --bin jarvis -- secrets set openai` (almacén del sistema).
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
JARVIS_VAULT_PATH=
# JARVIS_USER_NAME=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=cedar
